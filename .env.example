# --- Database ---
DATABASE_URL=postgresql://cctv:cctv123@localhost:5432/cctv_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=cctv_events

# --- Twilio Alerts (WhatsApp or SMS) ---
# Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# For Twilio WhatsApp: "whatsapp:+14155238886" (sandbox) or your Twilio WhatsApp number
# For Twilio SMS: "+1234567890"
TWILIO_FROM_NUMBER=whatsapp:+14155238886
# Recipient: "whatsapp:+1234567890" or "+1234567890"
TWILIO_TO_NUMBER=whatsapp:+1234567890
# Optional: public domain / ngrok URL to attach media images to Twilio alerts
PUBLIC_BASE_URL=

# --- Detection ---
UNKNOWN_FACE_THRESHOLD=0.45
RESTRICTED_OBJECTS=backpack,laptop,cell phone,handbag,suitcase
CONFIDENCE_THRESHOLD=0.4
LIGHT_MODEL=yolov8n.pt
FORENSIC_MODEL=yolov8m.pt

# --- Weapon Detection ---
WEAPON_DETECTION_ENABLED=true
WEAPON_MODEL_PATH=models/weapon/threat-yolov8n.pt
WEAPON_CONFIDENCE=0.30
WEAPON_CONFIRMATION_COUNT=1
WEAPON_CONFIRMATION_WINDOW_SECONDS=5.0
WEAPON_COOLDOWN_SECONDS=10.0
WEAPON_FORENSIC_ENABLED=false

# --- Snapshot storage ---
SNAPSHOT_DIR=data/snapshots

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cctv2024
