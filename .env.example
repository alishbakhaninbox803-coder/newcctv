# --- Database ---
DATABASE_URL=postgresql://cctv:cctv123@localhost:5432/cctv_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=cctv_events

# --- WhatsApp Cloud API (free tier via Meta for Developers) ---
WHATSAPP_TOKEN=your_temp_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ADMIN_NUMBER=91xxxxxxxxxx

# --- Detection ---
UNKNOWN_FACE_THRESHOLD=0.45
RESTRICTED_OBJECTS=backpack,laptop,cell phone,handbag,suitcase
CONFIDENCE_THRESHOLD=0.4
LIGHT_MODEL=yolov8n.pt
FORENSIC_MODEL=yolov8m.pt

# --- Weapon Detection ---
WEAPON_DETECTION_ENABLED=true
WEAPON_MODEL_PATH=models/weapon/threat-yolov8n.pt
WEAPON_CONFIDENCE=0.30
WEAPON_CONFIRMATION_COUNT=1
WEAPON_CONFIRMATION_WINDOW_SECONDS=5.0
WEAPON_COOLDOWN_SECONDS=10.0
WEAPON_FORENSIC_ENABLED=false

# --- Snapshot storage ---
SNAPSHOT_DIR=data/snapshots

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cctv2024
