# --- Database ---
DATABASE_URL=postgresql://cctv:cctv123@localhost:5432/cctv_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=cctv_events

# --- Meta WhatsApp Cloud API Alerts ---
# Meta for Developers: https://developers.facebook.com/apps/
# WhatsApp Cloud API Temporary or Permanent System User Access Token
WHATSAPP_TOKEN=
# Phone Number ID from WhatsApp Getting Started dashboard (e.g. 104xxxxxxxxxxxx)
WHATSAPP_PHONE_NUMBER_ID=
# Recipient phone number with country code without plus or spaces (e.g. 923001234567 or 15551234567)
WHATSAPP_ADMIN_NUMBER=

# --- Telegram Alerts ---
# Bot token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Chat ID of recipient user or channel/group (e.g. 123456789 or -100123456789)
TELEGRAM_CHAT_ID=

# --- Alert Fallback System ---
# ALERT_MODE: "fallback" (try primary, auto-fallback to secondary if failed) or "broadcast" (send to both)
ALERT_MODE=fallback
# PRIMARY_ALERT_PROVIDER: "whatsapp" or "telegram"
PRIMARY_ALERT_PROVIDER=whatsapp

# --- Detection ---
UNKNOWN_FACE_THRESHOLD=0.45
RESTRICTED_OBJECTS=backpack,laptop,cell phone,handbag,suitcase
CONFIDENCE_THRESHOLD=0.4
LIGHT_MODEL=yolov8n.pt
FORENSIC_MODEL=yolov8m.pt

# --- Weapon Detection ---
WEAPON_DETECTION_ENABLED=true
WEAPON_MODEL_PATH=models/weapon/threat-yolov8n.pt
WEAPON_CONFIDENCE=0.30
WEAPON_CONFIRMATION_COUNT=1
WEAPON_CONFIRMATION_WINDOW_SECONDS=5.0
WEAPON_COOLDOWN_SECONDS=10.0
WEAPON_FORENSIC_ENABLED=false

# --- Snapshot storage ---
SNAPSHOT_DIR=data/snapshots

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cctv2024
